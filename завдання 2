#include <iostream>
#include <ctime>

using namespace std;

int main() {
    srand(time(0));

    const int ROWS = 3;
    const int COLS = 3;

   
    int** matrix = new int*[ROWS];

    for (int i = 0; i < ROWS; i++) {
        matrix[i] = new int[COLS];
    }

    int evenCount = 0;
    int oddCount = 0;

   
    cout << "Масив:\n" << endl;

    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            matrix[i][j] = rand() % 100;

            cout.width(4);
            cout << matrix[i][j];

            if (matrix[i][j] % 2 == 0) {
                evenCount++;
            }
            else {
                oddCount++;
            }
        }
        cout << endl;
    }

    cout << "\nЕлементи головної діагоналі: ";

    for (int i = 0; i < ROWS; i++) {
        cout << matrix[i][i] << " ";
    }

  
    cout << "\nЕлементи побічної діагоналі: ";

    for (int i = 0; i < ROWS; i++) {
        cout << matrix[i][COLS - 1 - i] << " ";
    }

    cout << "\n\nКількість парних елементів: " << evenCount << endl;
    cout << "Кількість непарних елементів: " << oddCount << endl;

    
    for (int i = 0; i < ROWS; i++) {
        delete[] matrix[i];
    }

    delete[] matrix;

    return 0;
}
