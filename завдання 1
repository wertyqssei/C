#include <iostream>
#include <ctime>
using namespace std;

struct Date {
    int year;
    int month;
    int day;
};

bool isLeap(int year) {
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

int monthLength(int year, int month) {
    int days[12] = {31,28,31,30,31,30,31,31,30,31,30,31};
    if(month == 2)
        return isLeap(year) ? 29 : 28;
    return days[month - 1];
}

Date today() {
    time_t t = time(NULL);
    tm tl = *localtime(&t);
    Date d;
    d.year = tl.tm_year + 1900;
    d.month = tl.tm_mon + 1;
    d.day = tl.tm_mday;
    return d;
}

int daysFromBirth(Date birth, Date current) {
    int days = 0;

    while(birth.year < current.year || 
         (birth.year == current.year && birth.month < current.month) ||
         (birth.year == current.year && birth.month == current.month && birth.day < current.day)) {

        birth.day++;
        if(birth.day > monthLength(birth.year, birth.month)) {
            birth.day = 1;
            birth.month++;
            if(birth.month > 12) {
                birth.month = 1;
                birth.year++;
            }
        }
        days++;
    }

    return days;
}

int main() {
    Date birth;

    cout << "Enter birth date (year month day): ";
    cin >> birth.year >> birth.month >> birth.day;

    Date current = today();

    cout << daysFromBirth(birth, current) << endl;

    return 0;
}
