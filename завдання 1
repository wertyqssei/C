#include <iostream>
using namespace std;

class Tree{
public:
    virtual void draw() = 0;
};

class Tree1 : public Tree{
public:
    void draw(){
        cout << "Drawing 1:\n";
        cout << " /\\\n";
        cout << "//\\\\\n";
    }
};

class Tree2 : public Tree{
public:
    void draw(){
        cout << "Drawing 2:\n";
        cout << " /\\\n";
        cout << "/**\\\n";
    }
};

class Tree3 : public Tree{
public:
    void draw(){
        cout << "Drawing 3:\n";
        cout << " /\\\n";
        cout << "/++\\\n";
    }
};

int main(){
    Tree* trees[3];
    Tree1 t1;
    Tree2 t2;
    Tree3 t3;

    trees[0] = &t1;
    trees[1] = &t2;
    trees[2] = &t3;

    for(int i = 0; i < 3; i++){
        trees[i]->draw();
    }

    return 0;
}
