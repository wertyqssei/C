#include <iostream>
#include <ctime>

using namespace std;

int main() {
    srand(time(0));

    int size = 10;


    float* arr = new float[size];

    int positiveCount = 0;
    int negativeCount = 0;

  
    for (int i = 0; i < size; i++) {
        arr[i] = -2 + static_cast<float>(rand()) / RAND_MAX * 4;

        cout << "arr[" << i << "] = " << arr[i] << endl;

        if (arr[i] > 0) {
            positiveCount++;
        }
        else if (arr[i] < 0) {
            negativeCount++;
        }
    }

    cout << "\nКількість додатних чисел: " << positiveCount << endl;
    cout << "Кількість від'ємних чисел: " << negativeCount << endl;

    
    delete[] arr;

    return 0;
}
